#!/usr/bin/env bash
set -Eeuo pipefail

token_dir=/home/codex/.config/remote-browser
token_file="${REMOTE_BROWSER_EXTENSION_TOKEN_FILE:-${token_dir}/extension-token}"

fail() {
  printf 'Extension token was not changed: %s\n' "$1" >&2
  exit 64
}

[[ -t 0 && -t 1 && -r /dev/tty ]] || \
  fail 'run this command from an interactive TTY'
[[ "$#" == 0 ]] || fail 'this command accepts no arguments'
[[ "$(id -u)" == 0 ]] || fail 'run as root'
[[ "${token_file}" == "${token_dir}/extension-token" ]] || \
  fail 'the token path must use the private browser configuration directory'

install -d -o codex -g codex -m 0700 "${token_dir}"
[[ ! -L "${token_dir}" ]] || fail 'the token directory cannot be a symlink'

printf 'Paste the Playwright Extension token (input hidden): ' >/dev/tty
IFS= read -r -s extension_token </dev/tty || fail 'could not read from the TTY'
printf '\n' >/dev/tty

[[ ${#extension_token} -ge 16 && ${#extension_token} -le 1024 && \
  "${extension_token}" =~ ^[[:graph:]]+$ ]] || \
  fail 'token must contain 16 to 1024 visible characters'

umask 077
temporary_file="$(mktemp "${token_dir}/.extension-token.XXXXXX")"
cleanup() {
  if [[ -n "${temporary_file:-}" && -e "${temporary_file}" ]]; then
    shred -u "${temporary_file}" 2>/dev/null || unlink "${temporary_file}"
  fi
}
trap cleanup EXIT
printf '%s' "${extension_token}" >"${temporary_file}"
chown codex:codex "${temporary_file}"
chmod 0600 "${temporary_file}"
mv -f "${temporary_file}" "${token_file}"
temporary_file=
trap - EXIT
supervisorctl restart playwright-mcp >/dev/null
printf 'Playwright Extension token saved and the MCP service restarted.\n' >/dev/tty
