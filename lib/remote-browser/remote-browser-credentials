#!/usr/bin/env bash
set -Eeuo pipefail

credential_file="${REMOTE_BROWSER_CREDENTIALS_FILE:-/var/lib/codex-desktop-persistent/remote-browser/credentials.env}"
edge_credentials_file="${REMOTE_BROWSER_EDGE_CREDENTIALS_FILE:-}"
origin_file=/run/remote-browser/origin

fail() {
  printf 'Credentials were not displayed: %s\n' "$1" >&2
  exit 64
}

[[ "$#" == 0 ]] || fail 'this command accepts no arguments'
[[ -t 0 && -t 1 && -w /dev/tty ]] || \
  fail 'run this command from an interactive TTY'
[[ "$(id -u)" == 0 ]] || fail 'run this command as root'

if [[ -n "${edge_credentials_file}" ]]; then
  [[ -f "${edge_credentials_file}" && ! -L "${edge_credentials_file}" ]] || \
    fail 'edge credential file is unavailable'
  [[ "$(stat -c '%u:%g:%a' "${edge_credentials_file}" 2>/dev/null || true)" == \
    '0:0:600' ]] || fail 'edge credential file permissions are invalid'
  MCP_URL=
  MCP_TOKEN=
  MCP_COMPATIBILITY_URL=
  LOGIN_URL=
  LOGIN_TOKEN_URL=
  LOGIN_USERNAME=
  LOGIN_PASSWORD=
  while IFS='=' read -r key value || [[ -n "${key}${value}" ]]; do
    case "${key}" in
      MCP_URL) MCP_URL="${value}" ;;
      MCP_TOKEN) MCP_TOKEN="${value}" ;;
      MCP_COMPATIBILITY_URL) MCP_COMPATIBILITY_URL="${value}" ;;
      LOGIN_URL) LOGIN_URL="${value}" ;;
      LOGIN_TOKEN_URL) LOGIN_TOKEN_URL="${value}" ;;
      LOGIN_USERNAME) LOGIN_USERNAME="${value}" ;;
      LOGIN_PASSWORD) LOGIN_PASSWORD="${value}" ;;
      LOGIN_TOKEN|'') ;;
      *) fail 'edge credential file contains an unknown field' ;;
    esac
  done <"${edge_credentials_file}"
  [[ "${MCP_URL}" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/mcp$ ]] || \
    fail 'edge MCP URL is invalid'
  [[ "${MCP_TOKEN}" =~ ^[A-Za-z0-9_-]{32,128}$ ]] || \
    fail 'edge MCP token is invalid'
  [[ "${MCP_COMPATIBILITY_URL}" == "${MCP_URL%/mcp}/${MCP_TOKEN}/mcp" ]] || \
    fail 'edge MCP compatibility URL is inconsistent'
  [[ "${LOGIN_URL}" == "${MCP_URL%/mcp}/login/" ]] || \
    fail 'edge login URL is inconsistent'
  [[ "${LOGIN_TOKEN_URL}" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/login/\?token=[A-Za-z0-9_-]{32,128}$ ]] || \
    fail 'edge one-click URL is invalid'
  [[ "${LOGIN_USERNAME}" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || \
    fail 'edge login username is invalid'
  [[ ${#LOGIN_PASSWORD} -ge 20 && ${#LOGIN_PASSWORD} -le 128 ]] || \
    fail 'edge login password is invalid'
  {
    printf '%s\n' \
      'Remote browser credentials (keep this output private)' \
      "MCP URL: ${MCP_URL}" \
      "MCP bearer token: ${MCP_TOKEN}" \
      "MCP compatibility URL: ${MCP_COMPATIBILITY_URL}" \
      "noVNC one-click URL: ${LOGIN_TOKEN_URL}" \
      "noVNC Basic username: ${LOGIN_USERNAME}" \
      "noVNC Basic password: ${LOGIN_PASSWORD}"
  } >/dev/tty
  exit 0
fi

[[ -f "${credential_file}" && ! -L "${credential_file}" ]] || \
  fail 'credential file is unavailable'
[[ "$(stat -c '%u:%g:%a' "${credential_file}" 2>/dev/null || true)" == \
  '0:0:600' ]] || fail 'credential file permissions are invalid'

MCP_TOKEN=
LOGIN_TOKEN=
LOGIN_USERNAME=
LOGIN_PASSWORD=
while IFS='=' read -r key value; do
  case "${key}" in
    MCP_TOKEN) MCP_TOKEN="${value}" ;;
    LOGIN_TOKEN) LOGIN_TOKEN="${value}" ;;
    LOGIN_USERNAME) LOGIN_USERNAME="${value}" ;;
    LOGIN_PASSWORD) LOGIN_PASSWORD="${value}" ;;
    LOGIN_PASSWORD_HASH|'') ;;
    *) fail 'credential file contains an unknown field' ;;
  esac
done <"${credential_file}"

[[ "${MCP_TOKEN}" =~ ^[A-Za-z0-9_-]{32,128}$ ]] || fail 'MCP token is invalid'
[[ "${LOGIN_TOKEN}" =~ ^[A-Za-z0-9_-]{32,128}$ ]] || fail 'login token is invalid'
[[ "${LOGIN_USERNAME}" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || fail 'username is invalid'
[[ ${#LOGIN_PASSWORD} -ge 20 && ${#LOGIN_PASSWORD} -le 128 ]] || \
  fail 'password is invalid'

origin=
if [[ -f "${origin_file}" && ! -L "${origin_file}" ]]; then
  origin="$(<"${origin_file}")"
fi
[[ "${origin}" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || \
  fail 'gateway origin is not ready'
[[ "${origin}" != https://remote-browser.invalid ]] || \
  fail 'Tailscale HTTPS enrollment is not ready'

{
  printf '%s\n' \
    'Remote browser credentials (keep this output private)' \
    "MCP URL: ${origin}/mcp" \
    "MCP bearer token: ${MCP_TOKEN}" \
    "MCP compatibility URL: ${origin}/${MCP_TOKEN}/mcp" \
    "noVNC one-click URL: ${origin}/login/?token=${LOGIN_TOKEN}" \
    "noVNC Basic username: ${LOGIN_USERNAME}" \
    "noVNC Basic password: ${LOGIN_PASSWORD}"
} >/dev/tty
